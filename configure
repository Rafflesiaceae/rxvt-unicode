$ac_includes_default
long longval () { return (long) (sizeof (int *)); }
unsigned long ulongval () { return (long) (sizeof (int *)); }
#include <stdio.h>
#include <stdlib.h>
int
main ()
{

  FILE *f = fopen ("conftest.val", "w");
  if (! f)
    exit (1);
  if (((long) (sizeof (int *))) < 0)
    {
      long i = longval ();
      if (i != ((long) (sizeof (int *))))
	exit (1);
      fprintf (f, "%ld\n", i);
    }
  else
    {
      unsigned long i = ulongval ();
      if (i != ((long) (sizeof (int *))))
	exit (1);
      fprintf (f, "%lu\n", i);
    }
